@page "/login"
@using EventEase.Services
@inject UserSessionService Session
@inject NavigationManager Nav

<h1>Login</h1>

<div class="form-group">
    <label>Name:</label>
    <input @bind="name" />
</div>
<div class="form-group">
    <label>Email:</label>
    <input @bind="email" type="email" />
</div>
<button @onclick="HandleLogin">Log In</button>

@code {
    private string name = "";
    private string email = "";

    private void HandleLogin()
    {
        if (!string.IsNullOrWhiteSpace(name) && email.Contains("@"))
        {
            Session.Login(name, email);
            Nav.NavigateTo("/dashboard");
        }
    }
}

<style>
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-weight: bold; }
    .form-group input { width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; }
    button { padding: 0.75rem 1.5rem; background: #4a6fa5; color: white; border: none; border-radius: 4px; cursor: pointer; }
</style>